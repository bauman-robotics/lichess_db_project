# ⚠️ ВНИМАНИЕ: Этот файл содержит чувствительные данные!
# Не коммитить в репозиторий!
# Скопируйте в secrets.yaml и заполните

# Локальная база данных
local:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "your_password_here"
  sslmode: "disable"
  db_name: "lichess_games"

# Удаленная база данных (через SSH)
remote:
  database:
    host: "your-server-ip"
    port: 5432
    user: "db_user"
    password: "your_db_password_here"
    sslmode: "require"
  ssh:
    host: "your-server-ip"
    user: "ubuntu"
    port: 22
    key_path: "~/.ssh/id_rsa"
    key_password: null  # Если ключ зашифрован

# Обновление приложения на сервере (scripts/deploy/update_remote.py)
deploy:
  host: "your-server-ip"          # можно не указывать — возьмётся remote.ssh.host
  user: "ubuntu"                  # можно не указывать — remote.ssh.user
  port: 22
  key_path: "~/.ssh/id_rsa"
  key_password: null
  project_path: "/home/ubuntu/lichess_db_project"
  service: "lichess-analyzer"
  branch: "dev_1_service"         # пусто = текущая ветка сервера
  use_sudo: true                  # systemctl через sudo -n
  run_migrations: true            # setup_db.py --action create
  healthcheck_url: ""             # например http://127.0.0.1:5555/lichess-analyzer/
  strict_host_key: false          # true — требовать known_hosts

# Lichess API токен (опционально, для доступа к приватным данным)
lichess:
  api_token: "lip_your_api_token_here"  # Получите на https://lichess.org/account/oauth/token
  username: "your_lichess_username"

# Тестовая база данных
test:
  host: "localhost"
  port: 5433
  user: "test_user"
  password: "test_password"
  db_name: "test_lichess_db"

# Для режима api      — официальный api.deepseek.com 
deepseek:
  api_key: "sk-ТВОЙ_КЛЮЧ_ОТ_DEEPSEEK"