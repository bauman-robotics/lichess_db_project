# ⚠️ ВНИМАНИЕ: Этот файл содержит чувствительные данные!
# Не коммитить в репозиторий!
# Скопируйте в secrets.yaml и заполните

# Локальная база данных
local:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "your_password_here"
  sslmode: "disable"

# Удаленная база данных (через SSH)
remote:
  database:
    host: "your-server-ip"
    port: 5432
    user: "db_user"
    password: "your_db_password_here"
    sslmode: "require"
  ssh:
    host: "your-server-ip"
    user: "ubuntu"
    port: 22
    key_path: "~/.ssh/id_rsa"
    key_password: null  # Если ключ зашифрован

# Lichess API токен (опционально, для доступа к приватным данным)
lichess:
  api_token: "lip_your_api_token_here"  # Получите на https://lichess.org/account/oauth/token
  username: "your_lichess_username"

# Тестовая база данных
test:
  host: "localhost"
  port: 5433
  user: "test_user"
  password: "test_password"
  db_name: "test_lichess_db"
