# Пример файла с переменными окружения
# Скопируйте в .env и заполните

# Режим работы (local/remote)
DB_MODE=local

# Путь к конфигам
APP_CONFIG=config/app_config.yaml
SECRETS_CONFIG=config/secrets.yaml
SCHEMA_PATH=config/schemas/v1_lichess_games.yaml

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
